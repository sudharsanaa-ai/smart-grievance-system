# ==========================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ==========================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development

# 2. Database Connection
# Connection string from MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sgms_db

# 3. Security
# Secret used to sign JWT tokens (Long random string recommended)
JWT_SECRET=your_jwt_secret_key_here

# 4. CORS & Origins
# URL of your frontend application
FRONTEND_URL=http://localhost:5173

# 5. Media Storage (Cloudinary)
# Required for image and PDF attachments
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 6. Email Notifications (Nodemailer)
# Gmail user and App Password (not your regular password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
